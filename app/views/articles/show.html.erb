<div class="container w-50 mt-4">
  <p class="text-success"><%= notice %></p>
  <%= render @article %>
  <div class="mt-4 text-center d-flex justify-content-center gap-2">
    <%= link_to "Edit this article", edit_article_path(@article), class: "btn btn-primary" %> |
    <%= link_to "Back to articles", articles_path, class: "btn btn-secondary" %> |
    <%= button_to "Destroy this article", @article, method: :delete, data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "btn btn-danger"  %>
  </div>
</div>
