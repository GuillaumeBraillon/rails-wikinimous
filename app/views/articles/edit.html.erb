<div class="container w-50 mt-4 border p-4 rounded bg-light shadow-lg">
  <% content_for :title, "Editing article"%>
  <h1 class="text-center">Editing article</h1>
  <%= render "form", article: @article %>
  <br>
  <div class="mt-4 text-center d-flex justify-content-center gap-2">
    <%= link_to "Show this article", @article, class: "btn btn-primary" %> |
    <%= link_to "Back to articles", articles_path, class: "btn btn-secondary" %>
  </div>
</div>
